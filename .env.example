# Database Connection (SQLite default for local dev; PostgreSQL for production / docker)
DATABASE_URL="file:./dev.db"

# Application Brand & Environment
NEXT_PUBLIC_APP_NAME="Roamly"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE="true"

# Google Gemini AI Integration
# Users can also input their own Gemini API key directly in the UI upon login!
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# MapLibre Map Tile Configuration
NEXT_PUBLIC_MAPLIBRE_STYLE="https://demotiles.maplibre.org/style.json"
