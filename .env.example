# Database Connection (SQLite default for local dev; PostgreSQL for production / docker)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL for Docker:
# DATABASE_URL="postgresql://roamly:roamly@postgres:5432/roamly?schema=public"

# Application Brand & Environment
NEXT_PUBLIC_APP_NAME="Roamly"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE="true"

# Google Gemini AI Integration (server-side only)
# If left empty, Roamly seamlessly falls back to a deterministic, labeled demo AI planner
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# MapLibre Map Tile Configuration
NEXT_PUBLIC_MAPLIBRE_STYLE="https://demotiles.maplibre.org/style.json"

# Pluggable Phone OTP Configuration
DEMO_OTP_CODE="123456"

# Travel Expert Contact (Optional WhatsApp number)
NEXT_PUBLIC_WHATSAPP_NUMBER="+15550192834"
